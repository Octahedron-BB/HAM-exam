/* ============================================================
   首页 —— 对齐网页版：卡片描边、2×2 统计网格、级别卡
   ============================================================ */

/* ---- 用户条 ---- */
.user-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F0F3F6;
}

.user-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0F766E;
  color: #FFFFFF;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.user-meta {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.user-sub {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.user-arrow {
  color: #D1D5DB;
  font-size: 40rpx;
  line-height: 1;
  margin-left: 12rpx;
}

/* ---- 卡片头 ---- */
.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

/* ---- 统计 2×2 ---- */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stat-box {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  padding: 28rpx 16rpx;
  border-radius: 24rpx;
  background: #F0F3F6;
  text-align: center;
}

.stat-val {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #0F766E;
  line-height: 1.2;
}

.stat-lbl {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 6rpx;
}

/* ---- 级别选择 ---- */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.level-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  padding: 28rpx;
  border-radius: 24rpx;
  border: 3rpx solid #E5E7EB;
  background: #FFFFFF;
}

.level-card-active {
  border-color: #0F766E;
  background: #CCFBF1;
}

.level-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.level-code {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.level-card-active .level-code {
  color: #0F766E;
}

.level-count {
  font-size: 24rpx;
  color: #6B7280;
}

.level-card-active .level-count {
  color: #0F766E;
}

.level-name {
  font-size: 24rpx;
  color: #4B5563;
}

.level-card-active .level-name {
  color: #0F766E;
}

/* ---- 刷题方式 ---- */
.seg-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
  border: 3rpx solid #E5E7EB;
  background: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  color: #4B5563;
}

.seg-item-active {
  border-color: #0F766E;
  background: #CCFBF1;
  color: #0F766E;
}

.seg-hint {
  margin-top: 20rpx;
}

/* ---- 开始按钮 ---- */
.start-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

/* ---- 专项入口 ---- */
.entry-card {
  padding: 0 36rpx;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1px solid #E5E7EB;
}

.entry-row-last {
  border-bottom: none;
}

.entry-name {
  font-size: 28rpx;
  color: #111827;
}

.entry-meta {
  font-size: 24rpx;
  color: #6B7280;
}

/* ---- 底部 ---- */
.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
  padding: 8rpx 0 24rpx;
  line-height: 1.6;
}
