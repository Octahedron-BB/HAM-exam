/* ---- 用户条 ---- */
.user-bar {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 28rpx;
}

.user-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0F766E;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.user-meta {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2329;
}

.user-sub {
  font-size: 22rpx;
  color: #8A959D;
  margin-top: 4rpx;
}

.user-arrow {
  color: #B8C6C5;
  font-size: 40rpx;
  line-height: 1;
}

/* ---- 统计 ---- */
.stat-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 118, 110, 0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: #EDF1F1;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #0F766E;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #8A959D;
  margin-top: 6rpx;
}

/* ---- 卡片头部 ---- */
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

/* ---- 级别选择 ---- */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.level-item {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: #F4F6F6;
  border: 2rpx solid transparent;
}

.level-item-active {
  background: #E6F2F0;
  border-color: #0F766E;
}

.level-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2329;
}

.level-item-active .level-label {
  color: #0F766E;
}

.level-count {
  font-size: 22rpx;
  color: #8A959D;
  margin-top: 4rpx;
}

.level-item-active .level-count {
  color: #0F766E;
}

/* ---- 刷题方式 ---- */
.order-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.order-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  background: #F4F6F6;
  font-size: 26rpx;
  color: #4A5560;
}

.order-item-active {
  background: #0F766E;
  color: #FFFFFF;
  font-weight: 600;
}

.order-hint {
  margin-top: 18rpx;
  line-height: 1.7;
}

/* ---- 开始按钮 ---- */
.start-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

/* ---- 专项入口 ---- */
.entry-card {
  padding: 0 28rpx;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #EDF1F1;
}

.entry-row-last {
  border-bottom: none;
}

.entry-name {
  font-size: 28rpx;
  color: #1F2329;
}

.entry-meta {
  font-size: 24rpx;
  color: #8A959D;
}

/* ---- 底部 ---- */
.footer-tip {
  text-align: center;
  font-size: 20rpx;
  color: #A8B3B9;
  padding: 16rpx 0 40rpx;
}
