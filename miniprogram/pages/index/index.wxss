/* ============================================================
   首页 —— 对齐网页版视觉风格：柔和薄荷选中、胶囊分段器、进度条
   ============================================================ */

/* ---- 用户条 ---- */
.user-card {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #F0F3F6;
}

.user-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0F766E;
  color: #FFFFFF;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.user-meta {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.user-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.25;
}

.user-sub {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.user-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #0F766E;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ---- 卡片头 ---- */
.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

/* ---- 级别选择 ---- */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.level-card {
  width: calc(50% - 9rpx);
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #E5E7EB;
  background: #FFFFFF;
}

.level-card-active {
  border-color: #0F766E;
  background: #F0FDFA;
}

.level-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 6rpx;
}

.level-code {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.level-card-active .level-code {
  color: #0F766E;
}

.level-count {
  font-size: 22rpx;
  color: #6B7280;
}

.level-name {
  font-size: 22rpx;
  color: #4B5563;
  margin-bottom: 16rpx;
}

.mini-progress {
  height: 6rpx;
  background: #E5E7EB;
  border-radius: 999rpx;
  overflow: hidden;
}

.mini-progress-fill {
  height: 100%;
  background: #0F766E;
  border-radius: 999rpx;
}

/* ---- 刷题参数 ---- */
.config-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #4B5563;
  margin: 22rpx 0 12rpx;
}

.resume-hint {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #F0F3F6;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.dot-indicator {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0F766E;
  flex-shrink: 0;
}

.resume-hint-text {
  font-size: 24rpx;
  color: #4B5563;
}

.cta-row {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.cta-btn {
  flex: 1;
  width: auto !important;
  min-width: 0 !important;
}

/* ---- 考点 & 模考 2列快捷卡 ---- */
.feature-grid {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.feature-card {
  flex: 1;
  margin-bottom: 0;
  padding: 28rpx 26rpx;
}

.feature-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #CCFBF1;
  color: #0F766E;
  margin-bottom: 12rpx;
}

.feature-tag-amber {
  background: #FEF3C7;
  color: #D97706;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.feature-desc {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

/* ---- 偏好设置行 ---- */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1px solid #E5E7EB;
  gap: 20rpx;
}

.setting-row-last {
  border-bottom: none;
}

.setting-info {
  flex: 1;
}

.setting-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.setting-desc {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

/* ---- 统计 2×2 ---- */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.stat-box {
  width: calc(50% - 9rpx);
  box-sizing: border-box;
  padding: 24rpx 16rpx;
  border-radius: 24rpx;
  background: #F0F3F6;
  text-align: center;
}

.stat-val {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #0F766E;
  line-height: 1.2;
}

.stat-lbl {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 6rpx;
}

/* ---- 专项入口 ---- */
.entry-card {
  padding: 0 32rpx;
}

.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1px solid #E5E7EB;
}

.entry-row-last {
  border-bottom: none;
}

.entry-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.entry-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.entry-dot-danger { background: #DC2626; }
.entry-dot-amber { background: #D97706; }
.entry-dot-teal { background: #0F766E; }

.entry-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.entry-meta {
  font-size: 24rpx;
  color: #6B7280;
}

/* ---- 底部 ---- */
.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
  padding: 8rpx 0 24rpx;
  line-height: 1.6;
}
