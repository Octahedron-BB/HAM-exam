<view class="page-wrap">

  <!-- 顶部品牌与用户条 -->
  <view class="card user-card" bindtap="onLoginTap">
    <image
      wx:if="{{profile.avatarUrl}}"
      class="user-avatar"
      src="{{profile.avatarUrl}}"
      mode="aspectFill"
    />
    <view wx:else class="user-avatar user-avatar-empty">CQ</view>

    <view class="user-meta">
      <view class="user-name">{{loggedIn ? profile.nickName : 'HAM 题库'}}</view>
      <view class="user-sub">{{loggedIn ? 'CRAC A/B/C 类 · 点击修改资料' : '点击登录，记录属于你的刷题进度'}}</view>
    </view>

    <view class="user-action">{{loggedIn ? '资料 ›' : '登录 ›'}}</view>
  </view>

  <!-- 选择题库级别 -->
  <view class="card">
    <view class="card-header-row">
      <view>
        <view class="section-title">选择题库级别</view>
        <view class="section-desc">依据 CRAC 官方操作技术能力题库整理</view>
      </view>
      <view class="mono-pill">{{currentCount}} 题</view>
    </view>

    <view class="level-grid">
      <view
        wx:for="{{levels}}"
        wx:key="key"
        class="level-card {{level === item.key ? 'level-card-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onLevelTap"
      >
        <view class="level-top">
          <text class="level-code">{{item.label}}</text>
          <text class="level-count mono">{{item.count}} 题</text>
        </view>
        <view class="level-name">{{item.desc}}</view>
        <view class="mini-progress">
          <view class="mini-progress-fill" style="width: {{level === item.key && item.count ? (stats.total > 0 ? (stats.total > item.count ? 100 : (stats.total * 100 / item.count)) : 0) : 0}}%"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 刷题参数 + 同行双按钮 -->
  <view class="card">
    <view class="section-title">刷题参数</view>

    <view class="config-label">出题方式</view>
    <view class="segmented">
      <view
        wx:for="{{orders}}"
        wx:key="key"
        class="seg-btn {{order === item.key ? 'seg-btn-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onOrderTap"
      >{{item.label}}</view>
    </view>

    <view class="config-label">题型筛选</view>
    <view class="segmented">
      <view
        wx:for="{{qtypes}}"
        wx:key="key"
        class="seg-btn {{qtype === item.key ? 'seg-btn-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onQtypeTap"
      >{{item.label}}</view>
    </view>

    <view class="resume-hint">
      <view class="dot-indicator"></view>
      <text class="resume-hint-text">{{order === 'memorize' ? '背题模式：直接高亮显示正确答案' : (order === 'random' ? '随机刷题：打乱题目顺序，避免背位置' : '顺序刷题：支持断点续刷 · 共 ' + currentCount + ' 题')}}</text>
    </view>

    <view class="cta-row">
      <button class="btn-primary cta-btn" bindtap="onStart">开始刷题</button>
      <button wx:if="{{order !== 'memorize'}}" class="btn-secondary cta-btn" bindtap="onStartMemorize">背题模式</button>
    </view>
  </view>

  <!-- 考点专项 & 模拟组卷快捷入口 -->
  <view class="feature-grid">
    <view class="card feature-card" bindtap="onOpenSyllabus">
      <view class="feature-tag">考纲</view>
      <view class="feature-title">考点专项</view>
      <view class="feature-desc">5 大章 29 节逐一突破</view>
    </view>
    <view class="card feature-card" bindtap="onOpenExam">
      <view class="feature-tag feature-tag-amber">模考</view>
      <view class="feature-title">模拟组卷</view>
      <view class="feature-desc">A/B/C 全真限时 & 组卷</view>
    </view>
  </view>

  <!-- 学习概况 2×2 -->
  <view class="card">
    <view class="card-header-row">
      <view>
        <view class="section-title">学习概况</view>
        <view class="section-desc">当前账号答题记录</view>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stat-box">
        <view class="stat-val mono">{{stats.total}}</view>
        <view class="stat-lbl">已刷题目</view>
      </view>
      <view class="stat-box">
        <view class="stat-val mono">{{stats.accuracy}}%</view>
        <view class="stat-lbl">综合正确率</view>
      </view>
      <view class="stat-box">
        <view class="stat-val mono">{{stats.wrong}}</view>
        <view class="stat-lbl">当前错题</view>
      </view>
      <view class="stat-box">
        <view class="stat-val mono">{{stats.favorites}}</view>
        <view class="stat-lbl">收藏题目</view>
      </view>
    </view>
  </view>

  <!-- 专项入口（支持批量管理） -->
  <view class="card entry-card">
    <view class="entry-row" bindtap="onOpenWrong">
      <view class="entry-left">
        <view class="entry-dot entry-dot-danger"></view>
        <view class="entry-name">错题集（支持批量管理）</view>
      </view>
      <view class="entry-meta mono">{{stats.wrong}} 题 ›</view>
    </view>
    <view class="entry-row" bindtap="onOpenFavorite">
      <view class="entry-left">
        <view class="entry-dot entry-dot-amber"></view>
        <view class="entry-name">收藏集</view>
      </view>
      <view class="entry-meta mono">{{stats.favorites}} 题 ›</view>
    </view>
    <view class="entry-row entry-row-last" bindtap="onOpenNotes">
      <view class="entry-left">
        <view class="entry-dot entry-dot-teal"></view>
        <view class="entry-name">我的笔记</view>
      </view>
      <view class="entry-meta mono">{{stats.notes}} 条 ›</view>
    </view>
  </view>

  <!-- 偏好设置 -->
  <view class="card entry-card">
    <view class="setting-row">
      <view class="setting-info">
        <view class="setting-title">选项随机打乱</view>
        <view class="setting-desc">防止单选总在 A 位形成位置记忆</view>
      </view>
      <switch checked="{{shuffleOptions}}" color="#0F766E" bindchange="onToggleShuffle" />
    </view>
    <view class="setting-row setting-row-last">
      <view class="setting-info">
        <view class="setting-title">做对后自动移出错题集</view>
        <view class="setting-desc">重练答对时自动移出</view>
      </view>
      <switch checked="{{autoRemoveWrong}}" color="#0F766E" bindchange="onToggleAutoRemove" />
    </view>
  </view>

  <view class="footer-tip">HAM 题库 · 业余无线电操作技术能力刷题系统</view>
</view>
