/* 刷题页需要撑满可视区，用 page 高度而非 100vh：
   100vh 在小程序里含状态栏误差，会导致底部按钮被裁切 */
page {
  height: 100%;
  overflow: hidden;
  background: #F5F7F9;
}

.quiz-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
  background: #F5F7F9;
}

/* ---- 顶部进度细线（原版 3px）---- */
.progress-line {
  height: 6rpx;
  background: #E5E7EB;
  flex-shrink: 0;
}

.progress-fill {
  height: 100%;
  background: #0F766E;
  transition: width 0.2s ease;
}

/* ---- 顶栏 ---- */
.quiz-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1px solid #E5E7EB;
  flex-shrink: 0;
}

.quiz-counter {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
}

.fav-btn {
  font-size: 38rpx;
  line-height: 1;
  color: #D1D5DB;
  padding: 0 6rpx;
}

.fav-active {
  color: #D97706;
}

/* ---- 滚动区 ---- */
/* min-height: 0 是 flex 子项能正确滚动的关键，缺了它
   scroll-view 会被内容撑高，底部导航被挤出屏幕 */
.scroll-area {
  flex: 1;
  min-height: 0;
  padding: 32rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* ---- 题干 ---- */
.q-card {
  margin-bottom: 28rpx;
}

.q-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.q-badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.q-point {
  font-size: 22rpx;
  color: #9CA3AF;
}

.q-stem {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #111827;
  margin-bottom: 32rpx;
}

/* ---- 选项 ---- */
.q-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-btn {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  border: 3rpx solid #E5E7EB;
  background: #FFFFFF;
}

.option-key {
  width: 52rpx;
  height: 52rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 26rpx;
  font-weight: 700;
  color: #4B5563;
  flex-shrink: 0;
  margin-top: 1rpx;
  box-sizing: border-box;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.5;
  color: #111827;
  word-break: break-all;
}

/* 选中（多选未提交） */
.option-btn.picked {
  border-color: #0F766E;
  background: #CCFBF1;
}

.option-btn.picked .option-key {
  background: #0F766E;
  border-color: #0F766E;
  color: #FFFFFF;
}

/* 正确 */
.option-btn.correct {
  border-color: #059669;
  background: #D1FAE5;
}

.option-btn.correct .option-key {
  background: #059669;
  border-color: #059669;
  color: #FFFFFF;
}

/* 选错 */
.option-btn.wrong {
  border-color: #DC2626;
  background: #FEE2E2;
}

.option-btn.wrong .option-key {
  background: #DC2626;
  border-color: #DC2626;
  color: #FFFFFF;
}

.multi-submit {
  margin-top: 28rpx;
  width: 100%;
}

/* ---- 判分反馈（原版：卡片内、柔和底色、两端对齐）---- */
.q-feedback {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.q-feedback.is-correct {
  background: #D1FAE5;
  color: #059669;
}

.q-feedback.is-wrong {
  background: #FEE2E2;
  color: #DC2626;
}

.q-feedback.is-memorize {
  background: #CCFBF1;
  color: #0F766E;
}

.feedback-answer {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
}

/* ---- 笔记 ---- */
.note-card {
  margin-bottom: 40rpx;
}

.note-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.note-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4B5563;
}

.note-save {
  font-size: 24rpx;
  font-weight: 600;
  color: #0F766E;
  padding: 6rpx 12rpx;
}

.note-input {
  width: 100%;
  min-height: 140rpx;
  background: #F0F3F6;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: #111827;
}

/* ---- 底部 ---- */
.quiz-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid #E5E7EB;
  flex-shrink: 0;
}

.flex1 {
  flex: 1;
}

.flex2 {
  flex: 2;
}

.back-btn {
  margin-top: 40rpx;
  width: 320rpx;
}
