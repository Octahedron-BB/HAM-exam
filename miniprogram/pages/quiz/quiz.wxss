/* ============================================================
   刷题页 —— 对齐网页版 UI：精细描边、柔和反馈色、做题/背题胶囊、答题卡
   ============================================================ */

page {
  height: 100%;
  overflow: hidden;
  background: #F5F7F9;
}

.quiz-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
  background: #F5F7F9;
}

/* ---- 顶栏 ---- */
.quiz-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  background: #FFFFFF;
  border-bottom: 1px solid #E5E7EB;
  flex-shrink: 0;
  gap: 16rpx;
}

.quiz-top-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.quiz-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.25;
}

.quiz-counter {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 2rpx;
}

.quiz-top-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 做题 / 背题 胶囊切换 */
.mode-pill {
  display: flex;
  background: #F0F3F6;
  padding: 6rpx;
  border-radius: 999rpx;
  border: 1px solid #E5E7EB;
}

.mode-pill-btn {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #4B5563;
}

.mode-pill-active {
  background: #0F766E;
  color: #FFFFFF;
}

/* 圆形收藏星标按钮 */
.fav-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  border: 1px solid #E5E7EB;
  background: #FFFFFF;
  font-size: 34rpx;
  color: #9CA3AF;
  box-sizing: border-box;
}

.fav-active {
  color: #D97706;
  border-color: #F59E0B;
  background: #FEF3C7;
}

/* ---- 顶部进度细线 ---- */
.progress-line {
  height: 6rpx;
  background: #E5E7EB;
  flex-shrink: 0;
}

.progress-fill {
  height: 100%;
  background: #0F766E;
  transition: width 0.2s ease;
}

/* ---- 滚动区 ---- */
.scroll-area {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.scroll-inner {
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
}

/* ---- 题干 ---- */
.q-card {
  margin-bottom: 24rpx;
}

.q-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.q-badges {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.q-point {
  font-size: 22rpx;
  color: #6B7280;
}

.q-stem {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #111827;
  margin-bottom: 28rpx;
}

/* ---- 选项（柔和底色 + 细腻 2rpx 边框）---- */
.q-options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.option-btn {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  border: 2rpx solid #E5E7EB;
  background: #FFFFFF;
}

.option-key {
  width: 50rpx;
  height: 50rpx;
  line-height: 46rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #D1D5DB;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 24rpx;
  font-weight: 700;
  color: #4B5563;
  flex-shrink: 0;
  margin-top: 2rpx;
  box-sizing: border-box;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.5;
  color: #111827;
  word-break: break-all;
}

/* 选中（多选未提交） */
.option-btn.picked {
  border-color: #0F766E;
  background: #F0FDFA;
}

.option-btn.picked .option-key {
  background: #0F766E;
  border-color: #0F766E;
  color: #FFFFFF;
}

/* 正确 */
.option-btn.correct {
  border-color: #059669;
  background: #ECFDF5;
}

.option-btn.correct .option-key {
  background: #059669;
  border-color: #059669;
  color: #FFFFFF;
}

/* 选错 */
.option-btn.wrong {
  border-color: #DC2626;
  background: #FEF2F2;
}

.option-btn.wrong .option-key {
  background: #DC2626;
  border-color: #DC2626;
  color: #FFFFFF;
}

/* 长按排除 */
.option-btn.eliminated {
  opacity: 0.52;
  background: #F5F7F9;
  border-style: dashed;
}

.option-btn.eliminated .option-key {
  background: #9CA3AF;
  border-color: #9CA3AF;
  color: #FFFFFF;
}

.option-btn.eliminated .option-text {
  text-decoration: line-through;
  color: #9CA3AF;
}

.elim-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #E5E7EB;
  color: #6B7280;
  flex-shrink: 0;
  align-self: center;
}

.multi-submit {
  margin-top: 26rpx;
  width: 100%;
}

/* ---- 判分反馈 ---- */
.q-feedback {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.q-feedback.is-correct {
  background: #ECFDF5;
  color: #059669;
}

.q-feedback.is-wrong {
  background: #FEF2F2;
  color: #DC2626;
}

.q-feedback.is-memorize {
  background: #F0FDFA;
  color: #0F766E;
}

.feedback-answer {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
}

/* ---- 随手笔记 ---- */
.note-card {
  margin-bottom: 40rpx;
}

.note-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.note-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4B5563;
}

.note-save {
  font-size: 24rpx;
  font-weight: 600;
  color: #0F766E;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: #F0FDFA;
}

.note-input {
  width: 100%;
  min-height: 130rpx;
  background: #F5F7F9;
  border: 1px solid #E5E7EB;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.6;
  color: #111827;
}

/* ---- 底部 3 段式导航 ---- */
.quiz-footer {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid #E5E7EB;
  flex-shrink: 0;
}

.flex1 {
  flex: 1;
  width: auto !important;
  min-width: 0 !important;
}

.sheet-btn {
  width: 170rpx !important;
  min-width: 0 !important;
  flex-shrink: 0;
}

.back-btn {
  margin-top: 40rpx;
  width: 320rpx;
}

/* ---- 答题卡弹窗 ---- */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.sheet-panel {
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 74vh;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.sheet-close {
  font-size: 34rpx;
  color: #6B7280;
  padding: 8rpx 14rpx;
}

.sheet-legend {
  display: flex;
  gap: 28rpx;
  margin-bottom: 22rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.legend-current { border: 3rpx solid #0F766E; }
.legend-correct { background: #059669; }
.legend-wrong { background: #DC2626; }
.legend-todo { background: #F0F3F6; border: 1px solid #D1D5DB; }

.sheet-scroll {
  max-height: 52vh;
}

.sheet-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding-bottom: 12rpx;
}

.sheet-num {
  width: calc((100% - 70rpx) / 6);
  height: 76rpx;
  line-height: 74rpx;
  text-align: center;
  border-radius: 16rpx;
  border: 2rpx solid #E5E7EB;
  background: #F0F3F6;
  font-size: 26rpx;
  font-weight: 600;
  color: #4B5563;
  box-sizing: border-box;
}

.sheet-num.current {
  border-color: #0F766E;
  border-width: 3rpx;
  color: #0F766E;
  background: #F0FDFA;
}

.sheet-num.correct {
  background: #ECFDF5;
  border-color: #059669;
  color: #059669;
}

.sheet-num.wrong {
  background: #FEF2F2;
  border-color: #DC2626;
  color: #DC2626;
}

.sheet-num.answered {
  background: #F0FDFA;
  border-color: #0F766E;
  color: #0F766E;
}

.legend-answered {
  background: #0F766E;
}

/* ---- 模考顶栏计时与交卷 ---- */
.exam-timer {
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #F0F3F6;
  border: 1px solid #E5E7EB;
  color: #111827;
}

.exam-timer-urgent {
  color: #DC2626;
  border-color: #FCA5A5;
  background: #FEF2F2;
}

.exam-submit-pill {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #0F766E;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

/* ---- 成绩单弹窗 ---- */
.result-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.result-card {
  width: 100%;
  text-align: center;
  margin-bottom: 0;
}

.result-badge {
  display: inline-block;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  margin-bottom: 14rpx;
}

.result-pass {
  background: #ECFDF5;
  color: #059669;
}

.result-fail {
  background: #FEF2F2;
  color: #DC2626;
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 24rpx;
}

.result-score-box {
  padding: 28rpx 20rpx;
  border-radius: 24rpx;
  background: #F5F7F9;
  margin-bottom: 28rpx;
}

.result-score {
  font-size: 72rpx;
  font-weight: 700;
  color: #0F766E;
  line-height: 1.1;
}

.result-total {
  font-size: 30rpx;
  color: #6B7280;
  margin-left: 6rpx;
}

.result-sub {
  font-size: 24rpx;
  color: #4B5563;
  margin-top: 10rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

