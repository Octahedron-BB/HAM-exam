.syllabus-list {
  display: flex;
  flex-direction: column;
}

.chapter-card {
  padding: 0;
  overflow: hidden;
}

.chapter-head {
  padding: 28rpx;
  background: #F5F7F9;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.chapter-info {
  flex: 1;
  min-width: 0;
}

.chapter-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chapter-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.chapter-desc {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 6rpx;
}

.chapter-go {
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  background: #0F766E;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.section-list {
  border-top: 1px solid #E5E7EB;
}

.section-item {
  padding: 24rpx 28rpx;
  border-bottom: 1px solid #E5E7EB;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.section-item:last-child {
  border-bottom: none;
}

.section-main {
  flex: 1;
  min-width: 0;
}

.section-name-row {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.section-name {
  color: #111827;
}

.section-code {
  color: #0F766E;
  margin-right: 10rpx;
}

.section-count {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.section-btns {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.sec-btn {
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.sec-btn-primary {
  background: #0F766E;
  color: #FFFFFF;
}

.sec-btn-ghost {
  background: #F0F3F6;
  color: #111827;
  border: 1px solid #E5E7EB;
}
