/* 用 page 高度而非 100vh：小程序里 100vh 含状态栏误差，
   会让渐变分界线位置偏下 */
page {
  height: 100%;
}

.login-page {
  min-height: 100%;
  padding-top: 80rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #0F766E 0%, #0F766E 340rpx, #F4F6F6 340rpx, #F4F6F6 100%);
}

/* ---- 品牌 ---- */
.brand {
  text-align: center;
  padding: 20rpx 0 48rpx;
}

.brand-badge {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.brand-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 10rpx;
}

/* ---- 卡片 ---- */
.login-card {
  padding: 36rpx 32rpx 28rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

/* ---- 头像 ---- */
.avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-btn {
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #E6F2F0;
  border: 2rpx dashed #7FB8B2;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 22rpx;
  color: #0F766E;
  line-height: 1.4;
  text-align: center;
}

.avatar-tip {
  margin-left: 24rpx;
  flex: 1;
}

.tip-main {
  font-size: 26rpx;
  color: #1F2329;
}

.tip-sub {
  font-size: 22rpx;
  color: #8A959D;
  margin-top: 6rpx;
}

/* ---- 输入 ---- */
.field {
  margin-bottom: 36rpx;
}

.field-label {
  font-size: 24rpx;
  color: #6B7780;
  margin-bottom: 12rpx;
}

.field-input {
  height: 88rpx;
  background: #F4F6F6;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
}

.skip-row {
  text-align: center;
  font-size: 26rpx;
  color: #8A959D;
  padding: 28rpx 0 8rpx;
}

.privacy-tip {
  font-size: 21rpx;
  line-height: 1.7;
  color: #9AA5AB;
  padding: 8rpx 12rpx 0;
}

/* ---- 底部说明 ---- */
.notice {
  padding: 8rpx 8rpx 40rpx;
}

.notice-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7780;
  margin-bottom: 12rpx;
}

.notice-line {
  font-size: 22rpx;
  color: #8A959D;
  line-height: 1.9;
}
