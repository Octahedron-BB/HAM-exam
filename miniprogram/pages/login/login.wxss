page {
  height: 100%;
  background: #F5F7F9;
}

.login-page {
  min-height: 100%;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---- 品牌 ---- */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 40rpx;
}

.brand-badge {
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  border-radius: 28rpx;
  background: #0F766E;
  color: #FFFFFF;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0.05em;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 118, 110, 0.2);
}

.brand-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.25;
}

.brand-sub {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 8rpx;
}

/* ---- 表单卡 ---- */
.login-card {
  padding: 36rpx 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  text-align: center;
  margin-bottom: 32rpx;
}

.avatar-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

/* 关键：!important 覆盖微信 style:v2 button 默认 184px 宽度，避免被拉成椭圆 */
.avatar-btn {
  width: 144rpx !important;
  height: 144rpx !important;
  min-width: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50%;
  background: #F5F7F9;
  border: 2rpx dashed #CBD5E1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.avatar-img {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  display: block;
}

.avatar-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6B7280;
}

.avatar-plus {
  font-size: 40rpx;
  line-height: 1;
  color: #0F766E;
  font-weight: 500;
}

.avatar-hint {
  font-size: 20rpx;
  margin-top: 4rpx;
}

.avatar-caption {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 14rpx;
}

/* ---- 输入 ---- */
.field {
  margin-bottom: 36rpx;
}

.field-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #4B5563;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  height: 92rpx;
  background: #F5F7F9;
  border: 1px solid #E5E7EB;
  border-radius: 22rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

.submit-btn {
  width: 100% !important;
}

.skip-row {
  text-align: center;
  font-size: 26rpx;
  color: #6B7280;
  padding: 28rpx 0 4rpx;
}

/* ---- 底部说明 ---- */
.notice-card {
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid #E5E7EB;
}

.notice-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #4B5563;
  margin-bottom: 10rpx;
}

.notice-line {
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.8;
}
