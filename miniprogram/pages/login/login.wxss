page {
  height: 100%;
  background: #F5F7F9;
}

.login-page {
  min-height: 100%;
  padding: 56rpx 32rpx 40rpx;
  box-sizing: border-box;
}

/* ---- 品牌 ---- */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 44rpx;
}

.brand-badge {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 26rpx;
  background: #0F766E;
  color: #FFFFFF;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  margin-bottom: 24rpx;
}

.brand-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.brand-sub {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 8rpx;
}

/* ---- 表单卡 ---- */
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 32rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #F0F3F6;
  border: 3rpx dashed #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  box-sizing: border-box;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.4;
  text-align: center;
}

.avatar-tip {
  margin-left: 24rpx;
  flex: 1;
}

.tip-main {
  font-size: 26rpx;
  color: #111827;
}

.tip-sub {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 6rpx;
}

/* ---- 输入 ---- */
.field {
  margin-bottom: 36rpx;
}

.field-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
}

.field-input {
  height: 88rpx;
  background: #F0F3F6;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
}

.skip-row {
  text-align: center;
  font-size: 26rpx;
  color: #6B7280;
  padding: 28rpx 0 6rpx;
}

.privacy-tip {
  font-size: 22rpx;
  line-height: 1.7;
  color: #9CA3AF;
  padding: 24rpx 8rpx 0;
}

/* ---- 底部说明 ---- */
.notice {
  padding: 40rpx 8rpx 16rpx;
}

.notice-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #4B5563;
  margin-bottom: 12rpx;
}

.notice-line {
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.9;
}
