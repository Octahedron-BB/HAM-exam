<view class="login-page">
  <!-- 品牌区 -->
  <view class="brand">
    <view class="brand-badge">CQ</view>
    <view class="brand-title">HAM 题库</view>
    <view class="brand-sub">中国业余无线电 A / B / C 类操作证刷题</view>
  </view>

  <!-- 登录表单卡 -->
  <view class="card login-card">
    <view class="card-title">{{isEdit ? '编辑个人资料' : '设置呼号 / 昵称'}}</view>

    <!-- 居中正圆头像选择 -->
    <view class="avatar-center">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-empty">
          <text class="avatar-plus">+</text>
          <text class="avatar-hint">选头像</text>
        </view>
      </button>
      <view class="avatar-caption">{{avatarUrl ? '点击头像可更换' : '点击选择微信头像（仅本机保存）'}}</view>
    </view>

    <view class="field">
      <view class="field-label">呼号或昵称</view>
      <input
        class="field-input"
        type="nickname"
        placeholder="例如：BH1ABC 或 你的昵称"
        value="{{nickName}}"
        bindinput="onNickInput"
        maxlength="20"
      />
    </view>

    <button
      class="btn-primary submit-btn"
      bindtap="onSubmit"
      disabled="{{!canSubmit || submitting}}"
    >{{isEdit ? '保存资料' : '进入 HAM 题库'}}</button>

    <view wx:if="{{!isEdit}}" class="skip-row" bindtap="onSkip">暂不设置，直接刷题</view>
  </view>

  <!-- 隐私与数据说明 -->
  <view class="notice-card">
    <view class="notice-title">隐私与数据说明</view>
    <view class="notice-line">· 头像、昵称、刷题记录、错题与笔记均保存在本机</view>
    <view class="notice-line">· 不会上传个人隐私信息，卸载或清缓存后数据将重置</view>
    <view class="notice-line">· 本程序为业余无线电学习辅助工具，与官方机构无隶属关系</view>
  </view>
</view>
