.summary-card {
  padding: 32rpx;
}

.summary-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.summary-date {
  font-size: 22rpx;
  color: #6B7280;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 24rpx;
}

.summary-stats {
  display: flex;
  gap: 14rpx;
}

.sum-box {
  flex: 1;
  padding: 20rpx 12rpx;
  border-radius: 20rpx;
  background: #F5F7F9;
  text-align: center;
}

.sum-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #0F766E;
}

.sum-sub {
  font-size: 22rpx;
  color: #6B7280;
  margin-left: 2rpx;
}

.sum-lbl {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.summary-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.act-btn {
  flex: 1;
  width: auto !important;
  min-width: 0 !important;
}

.filter-card {
  padding: 20rpx;
}

.detail-item {
  padding: 28rpx;
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.detail-badges {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.detail-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #4B5563;
}

.detail-id {
  font-size: 22rpx;
  color: #9CA3AF;
}

.detail-q {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.55;
  margin-bottom: 18rpx;
}

.detail-opts {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.detail-opt {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #F5F7F9;
  font-size: 25rpx;
  line-height: 1.45;
  color: #374151;
}

.detail-opt.opt-correct {
  background: #ECFDF5;
  color: #059669;
  font-weight: 600;
}

.detail-opt.opt-wrong {
  background: #FEF2F2;
  color: #DC2626;
}

.detail-opt-key {
  font-weight: 700;
  flex-shrink: 0;
}

.detail-opt-text {
  flex: 1;
}

.detail-ans-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14rpx;
  border-top: 1px solid #E5E7EB;
  font-size: 24rpx;
  font-weight: 600;
}

.ans-mine { font-weight: 600; }
.ans-ok { color: #059669; }
.ans-bad { color: #DC2626; }
.ans-right { color: #0F766E; }
