/* ============================================================
   全局视觉规范 —— 对齐网页版 styles.css
   色值 / 圆角 / 边框 / 阴影 / 字号层级均取自原设计系统
   ============================================================ */

page {
  min-height: 100%;
  background: #F5F7F9;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

button {
  font-family: inherit;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* 等宽数字，对齐原版 --font-mono */
.mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.page-wrap {
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---- 卡片：1px 边框 + 极轻阴影 ---- */
.card {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 6rpx rgba(17, 24, 39, 0.04);
  margin-bottom: 24rpx;
}

/* ---- 文本层级 ---- */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.section-desc {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ---- 药丸标签 ---- */
.mono-pill {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #F0FDFA;
  border: 1px solid #99F6E4;
  color: #0F766E;
  white-space: nowrap;
}

/* ---- 徽标 ---- */
.badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: #CCFBF1;
  color: #0F766E;
}

.badge-multi {
  background: #FEF3C7;
  color: #D97706;
}

.badge-warn {
  background: #FEE2E2;
  color: #DC2626;
}

/* ---- 分段胶囊控制器（对齐原版 .segmented）---- */
.segmented {
  display: flex;
  background: #F0F3F6;
  padding: 8rpx;
  border-radius: 24rpx;
  gap: 8rpx;
}

.seg-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #4B5563;
}

.seg-btn-active {
  background: #FFFFFF;
  color: #111827;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(17, 24, 39, 0.08);
}

/* ---- 主按钮 ---- */
.btn-primary {
  width: 100%;
  background: #0F766E;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 24rpx;
}

.btn-primary[disabled] {
  background: #0F766E;
  opacity: 0.45;
  color: #FFFFFF;
}

/* ---- 次按钮（浅灰底）---- */
.btn-secondary {
  width: 100%;
  background: #F0F3F6;
  color: #111827;
  border: 1px solid #E5E7EB;
  font-size: 28rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 90rpx;
  text-align: center;
  border-radius: 24rpx;
}

/* ---- 描边按钮 ---- */
.btn-ghost {
  width: 100%;
  background: transparent;
  color: #4B5563;
  border: 1px solid #E5E7EB;
  font-size: 28rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 86rpx;
  text-align: center;
  border-radius: 24rpx;
}

.btn-ghost[disabled] {
  opacity: 0.45;
}

.empty-state {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.7;
}

.hidden {
  display: none !important;
}
