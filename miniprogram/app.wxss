page {
  min-height: 100%;
  background: #F4F6F6;
  color: #1F2329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

button {
  border-radius: 16rpx;
}

button::after {
  border: none;
}

/* ---- 通用容器 ---- */
.page-wrap {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 118, 110, 0.06);
  margin-bottom: 24rpx;
}

/* ---- 文本层级 ---- */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2329;
}

.section-desc {
  font-size: 24rpx;
  color: #6B7780;
  margin-top: 6rpx;
}

.mono {
  font-variant-numeric: tabular-nums;
}

/* ---- 主色按钮 ---- */
.btn-primary {
  background: #0F766E;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
}

.btn-primary[disabled] {
  background: #B8C6C5;
  color: #FFFFFF;
}

.btn-ghost {
  background: #FFFFFF;
  color: #0F766E;
  border: 2rpx solid #0F766E;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
}

.btn-sm {
  height: 56rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
}

/* ---- 标签 ---- */
.pill {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #E6F2F0;
  color: #0F766E;
  font-weight: 600;
}

.pill-active {
  background: #0F766E;
  color: #FFFFFF;
}

/* ---- 空状态 ---- */
.empty-state {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #8A959D;
  font-size: 26rpx;
}

.hidden {
  display: none !important;
}
